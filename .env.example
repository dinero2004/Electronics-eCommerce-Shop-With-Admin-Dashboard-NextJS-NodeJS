# Frontend and API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
INTERNAL_API_BASE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# MySQL (use the same value in server/.env)
DATABASE_URL="mysql://shop_user:shop_password@127.0.0.1:3306/my_first_online_shop"

# Payments: mock is safe for local development. Use stripe only with test/live keys.
PAYMENTS_MODE=mock
ALLOW_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
