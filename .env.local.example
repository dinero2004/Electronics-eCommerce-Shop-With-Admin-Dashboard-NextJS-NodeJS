# Copy this file to .env.local for local Node development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
INTERNAL_API_BASE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://shop_user:shop_password@127.0.0.1:3306/my_first_online_shop
NODE_ENV=development

# Keep mock mode until Stripe test keys are configured.
PAYMENTS_MODE=mock
ALLOW_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Docker Compose values (used with: docker compose --env-file .env.local up --build)
MYSQL_DATABASE=my_first_online_shop
MYSQL_USER=shop_user
MYSQL_PASSWORD=shop_password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
